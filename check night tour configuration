class Solution {
public:
    bool checkValidGrid(vector<vector<int>>& grid) {
       int n = grid.size() ;
       if(grid[0][0]!=0) return false ;
       vector<pair<int,int>> position(n*n) ;
       for(int i=0;i<n;i++){
        for(int j=0;j<n;j++){
            position[grid[i][j]] = {i,j} ;

        }
       }
       for(int i=0;i<n*n-1;i++){
        int x1 = position[i].first ;
        int y1 = position[i].second ;
        int x2 = position[i+1].first ;
        int y2 = position[i+1].second ;
        int dx = abs(x2-x1) ;
        int dy = abs(y2-y1) ;
        if(!((dx==1 && dy==2) || (dx==2 && dy==1))){
            return false ;
        }
       }
    return true ;
    }
};     
