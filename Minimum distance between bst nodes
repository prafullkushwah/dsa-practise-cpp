class Solution {
public:
    int minDiff = INT_MAX ;
    TreeNode* prev = NULL ;
    void inOrder(TreeNode* root){
        if(root==NULL) return ;
        inOrder(root->left) ;
        if(prev!=NULL){
            minDiff = min(minDiff,root->val-prev->val) ;
        }
        prev = root ;
        inOrder(root->right) ;
    }
    int minDiffInBST(TreeNode* root) {
        inOrder(root) ;
        return minDiff ;
    }
};
